# M1 EXTERNAL INSTANCE configuration (trusted Bash, chmod 600).
# KIT_ROOT / OPERATOR_HOME are supplied by the launcher. Do not override them here.
# Replace placeholders before '--stage config' verification.
CONV_URL="https://chatgpt.com/c/REPLACE-WITH-CONVERSATION-ID"
CDP_PORT="9225"
BROWSER_KIND="chrome"
CHROME_PROFILE_DIR="$OPERATOR_HOME/chrome-cdp-profile"
HTTP_PROXY_FOR_CHROME=""
PROXY_BYPASS="localhost;127.0.0.1"
CAPTION_STOPWORDS=""
CAPTION_MIN_TOKEN_LEN="4"
DELIVERY_CAPTION_RE=""
# BOARD is required for real board execution in the upstream workflow.
BOARD="REPLACE-WITH-user@host"
BOARD_LOCKDIR="/root/.bench-lock"
BOARD_IDLE_MIN="60"
BOARD_LOCK_STALE="300"
ASKPASS="$OPERATOR_HOME/_ssh/askpass.sh"
NODE_BIN_DIR="REPLACE-WITH-/absolute/path/to/node/bin"
STATE_DIR="$OPERATOR_HOME/state"
INCOMING_DIR="$OPERATOR_HOME/incoming"
MAX_GLIBC="GLIBC_2.31"
CROSS_CC="aarch64-linux-gnu-gcc"
CROSS_READELF="aarch64-linux-gnu-readelf"
SYSROOT_231=""
FROZEN_ROOT=""
PROJECT_ROOT=""
DEV_TREE=""
PROJECT_ENV=""
LOCK_OWNER="REPLACE-WITH-instance-owner"
