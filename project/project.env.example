# M1 project contract template; trusted Bash, instance-scoped.
IDENTITY_ROOT="$DEV_TREE"
IDENTITY_MANIFEST="$OPERATOR_HOME/project/identity/accepted.sha256"
IDENTITY_FILES="REPLACE-WITH-src/your_production.c REPLACE-WITH-include/your_header.h"
PREIMAGE_MANIFEST=""
ROUND_TAG_SED='s/^.*_\(B[0-9]*_T[0-9]*\)_DELIVERY_.*$/\1/p'
PROJECT_SCRIPTS_DIR="scripts"
HOOK_VERIFY_NAME="{tag}_verify_patch.sh"
HOOK_SELFTEST_NAME="{tag}_native_selftest.sh"
HOOK_PAIREQUIV_NAME="{tag}_pair_equiv_host.sh"
HOOK_BUILD_NAME="a53_build_{tag}_host.sh"
HOOK_RUN_NAME="a53_run_{tag}_target.sh"
DEPLOY_NAME_PATTERN="generic_a53_{tag}"
BOARD_RUN_ROOT="/root"
BOARD_RUN_CMD="taskset -c 0 bash {board_dir}/scripts/{run_script} {result_dir}"
